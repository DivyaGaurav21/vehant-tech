NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/trafficiq
# Use the deployed frontend origin in production; comma-separate allowed origins if needed.
CLIENT_ORIGIN=http://localhost:5173
SIMULATION_INTERVAL_MS=3000
SIM_NO_HELMET_PROBABILITY=0.08
SIM_RED_LIGHT_PROBABILITY=0.025
SIM_WRONG_SIDE_PROBABILITY=0.012
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=
ADMIN_PASSWORD=
